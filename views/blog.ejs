<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("./partials/head") %>
        <title>Blog-Home</title>
</head>

<body>
    <%- include("./partials/navbar") %>

        <div class="container">
            <h1>
                <%= blog.title %>
            </h1>
            <% if (locals.blog.coverImageURL) { %>
                <img src="<%= blog.coverImageURL %>" alt="No Cover Image" width="700px">
                <% } %>

                    <pre><%= blog.body %></pre>
        </div>

        <div class="container mt-4 mb-3">
            <img style="border-radius: 50%;"
                src="<%= blog.createdBy.profileImage.startsWith('./') ? blog.createdBy.profileImage.replace('./', '/') : blog.createdBy.profileImage %>"
                width="50" alt="Image Unavailable">
            <b>
                <%= blog.createdBy.fullname %>
            </b>
        </div>

        <div class="container mt-4 mb-3">
            <h3> Comments (<%= comments.length %>) </h3>
            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post">
                    <div class="mb-3">
                        <input type="text" name="content" class="form-control" placeholder="Enter Your comment">
                    </div>
                    <button type="submit" class="btn btn-primary">Add</button>
                </form>
                <% } %>
            <div class="mt-3">
                <% comments.forEach(comment=> { %>
                    <div class="mt-1 p-2" style="border: 2px solid black;border-radius: 10px;">
                        <img style="border-radius: 50%;"
                            src="<%= comment.createdBy.profileImage.startsWith('./') ? comment.createdBy.profileImage.replace('./', '/') : comment.createdBy.profileImage %>"
                            width="30" alt="Image Unavailable" />
                        <%= comment.createdBy.fullname %>
                        <pre>
                            <%= comment.content %>
                        </pre>
                    </div>
                    <% }) %>
            </div>
        </div>

        <%- include("./partials/script") %>
</body>

</html>